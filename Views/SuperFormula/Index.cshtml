    <script>


// ============================================================
// GLOBAL THREE.JS VARIABLES
// ============================================================

var scene;

var camera;

var renderer;

var particles;

var particleMaterial;

var particleGeometry;


// ============================================================
// ROTATION VARIABLES
// ============================================================

var rotationX = 0;

var rotationY = 0;

var targetRotationX = 0;

var targetRotationY = 0;


var isDragging = false;

var previousMouseX = 0;

var previousMouseY = 0;


// ============================================================
// CAMERA ZOOM
// ============================================================

var cameraDistance = 450;


// ============================================================
// DEFAULT VALUES
// ============================================================

var DEFAULTS = {

    m1: @Model.M1.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    n1a: @Model.N1A.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    n2a: @Model.N2A.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    n3a: @Model.N3A.ToString(
        System.Globalization.CultureInfo.InvariantCulture),


    m2: @Model.M2.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    n1b: @Model.N1B.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    n2b: @Model.N2B.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    n3b: @Model.N3B.ToString(
        System.Globalization.CultureInfo.InvariantCulture),


    scale: @Model.Scale.ToString(
        System.Globalization.CultureInfo.InvariantCulture),

    particleSize: @Model.ParticleSize.ToString(
        System.Globalization.CultureInfo.InvariantCulture)

};


// ============================================================
// GET HTML ELEMENT
// ============================================================

function getElement(id) {

    return document.getElementById(id);

}


// ============================================================
// GET NUMBER
// ============================================================

function getNumber(id) {

    return parseFloat(
        getElement(id).value
    );

}


// ============================================================
// SUPER FORMULA
// ============================================================

function superFormula(
    angle,
    m,
    n1,
    n2,
    n3,
    a,
    b
) {

    var part1 =
        Math.cos(
            m * angle / 4
        ) / a;


    var part2 =
        Math.sin(
            m * angle / 4
        ) / b;


    var value1 =
        Math.pow(
            Math.abs(part1),
            n2
        );


    var value2 =
        Math.pow(
            Math.abs(part2),
            n3
        );


    var sum =
        value1 + value2;


    if (sum <= 0) {

        return 0;

    }


    var result =
        Math.pow(
            sum,
            -1 / n1
        );


    return result;

}


// ============================================================
// CREATE 3D SUPERFORMULA
// ============================================================

function createSuperFormula() {


    // --------------------------------------------------------
    // Read values
    // --------------------------------------------------------

    var m1 =
        getNumber("m1");


    var n1a =
        getNumber("n1a");


    var n2a =
        getNumber("n2a");


    var n3a =
        getNumber("n3a");


    var m2 =
        getNumber("m2");


    var n1b =
        getNumber("n1b");


    var n2b =
        getNumber("n2b");


    var n3b =
        getNumber("n3b");


    var scale =
        getNumber("scale");


    // --------------------------------------------------------
    // Remove previous geometry
    // --------------------------------------------------------

    if (particles) {

        scene.remove(particles);

        particles.geometry.dispose();

    }


    // --------------------------------------------------------
    // Resolution
    //
    // 160 x 80 = 12,800 particles
    //
    // Increase these values for more detail.
    // --------------------------------------------------------

    var thetaSteps = 160;

    var phiSteps = 80;


    var totalPoints =
        thetaSteps * phiSteps;


    var positions =
        new Float32Array(
            totalPoints * 3
        );


    var index = 0;


    // --------------------------------------------------------
    // Generate mathematical surface
    // --------------------------------------------------------

    for (
        var i = 0;
        i < thetaSteps;
        i++
    ) {


        // Around the object

        var theta =
            -Math.PI +
            (
                2 * Math.PI * i
                / (thetaSteps - 1)
            );


        // First SuperFormula

        var r1 =
            superFormula(
                theta,
                m1,
                n1a,
                n2a,
                n3a,
                1,
                1
            );


        for (
            var j = 0;
            j < phiSteps;
            j++
        ) {


            // Top to bottom

            var phi =
                -Math.PI / 2 +
                (
                    Math.PI * j
                    / (phiSteps - 1)
                );


            // Second SuperFormula

            var r2 =
                superFormula(
                    phi,
                    m2,
                    n1b,
                    n2b,
                    n3b,
                    1,
                    1
                );


            // ------------------------------------------------
            // 3D PARAMETRIC EQUATION
            // ------------------------------------------------

            var x =
                r1 *
                Math.cos(phi) *
                Math.cos(theta) *
                scale;


            var y =
                r1 *
                Math.cos(phi) *
                Math.sin(theta) *
                scale;


            var z =
                r2 *
                Math.sin(phi) *
                scale;


            // ------------------------------------------------
            // Store point
            // ------------------------------------------------

            positions[index++] = x;

            positions[index++] = y;

            positions[index++] = z;

        }

    }


    // ========================================================
    // THREE.JS GEOMETRY
    // ========================================================

    particleGeometry =
        new THREE.BufferGeometry();


    particleGeometry.setAttribute(
        "position",
        new THREE.BufferAttribute(
            positions,
            3
        )
    );


    // ========================================================
    // PARTICLE MATERIAL
    // ========================================================

    var particleSize =
        getNumber("particleSize");


    particleMaterial =
        new THREE.PointsMaterial({

            color: 0xff55ff,

            size: particleSize,

            transparent: true,

            opacity: 0.85,

            blending:
                THREE.AdditiveBlending,

            depthWrite: false,

            sizeAttenuation: true

        });


    // ========================================================
    // CREATE PARTICLES
    // ========================================================

    particles =
        new THREE.Points(
            particleGeometry,
            particleMaterial
        );


    scene.add(particles);


    // ========================================================
    // UPDATE VALUES
    // ========================================================

    updateLabels();

}


// ============================================================
// UPDATE SLIDER LABELS
// ============================================================

function updateLabels() {


    getElement("m1Value").innerHTML =
        getNumber("m1").toFixed(2);


    getElement("n1aValue").innerHTML =
        getNumber("n1a").toFixed(2);


    getElement("n2aValue").innerHTML =
        getNumber("n2a").toFixed(2);


    getElement("n3aValue").innerHTML =
        getNumber("n3a").toFixed(2);


    getElement("m2Value").innerHTML =
        getNumber("m2").toFixed(2);


    getElement("n1bValue").innerHTML =
        getNumber("n1b").toFixed(2);


    getElement("n2bValue").innerHTML =
        getNumber("n2b").toFixed(2);


    getElement("n3bValue").innerHTML =
        getNumber("n3b").toFixed(2);


    getElement("scaleValue").innerHTML =
        getNumber("scale").toFixed(0);


    getElement("particleSizeValue").innerHTML =
        getNumber("particleSize").toFixed(1);

}


// ============================================================
// INITIALIZE THREE.JS
// ============================================================

function initializeThree() {


    var container =
        getElement("threeContainer");


    // ========================================================
    // SCENE
    // ========================================================

    scene =
        new THREE.Scene();


    // ========================================================
    // CAMERA
    // ========================================================

    camera =
        new THREE.PerspectiveCamera(

            45,

            container.clientWidth /
            container.clientHeight,

            1,

            2000

        );


    camera.position.z =
        cameraDistance;


    // ========================================================
    // RENDERER
    // ========================================================

    renderer =
        new THREE.WebGLRenderer({

            antialias: true,

            alpha: true

        });


    renderer.setPixelRatio(
        window.devicePixelRatio
    );


    renderer.setSize(
        container.clientWidth,
        container.clientHeight
    );


    renderer.setClearColor(
        0x000000,
        1
    );


    container.appendChild(
        renderer.domElement
    );


    // ========================================================
    // CREATE INITIAL OBJECT
    // ========================================================

    createSuperFormula();


    // ========================================================
    // MOUSE EVENTS
    // ========================================================

    renderer.domElement.addEventListener(
        "mousedown",
        mouseDown
    );


    renderer.domElement.addEventListener(
        "mousemove",
        mouseMove
    );


    renderer.domElement.addEventListener(
        "mouseup",
        mouseUp
    );


    renderer.domElement.addEventListener(
        "mouseleave",
        mouseUp
    );


    // ========================================================
    // TOUCH EVENTS
    // ========================================================

    renderer.domElement.addEventListener(
        "touchstart",
        touchStart,
        { passive: false }
    );


    renderer.domElement.addEventListener(
        "touchmove",
        touchMove,
        { passive: false }
    );


    renderer.domElement.addEventListener(
        "touchend",
        touchEnd
    );


    // ========================================================
    // ZOOM
    // ========================================================

    renderer.domElement.addEventListener(
        "wheel",
        mouseWheel,
        { passive: false }
    );


    // ========================================================
    // RESIZE
    // ========================================================

    window.addEventListener(
        "resize",
        resize
    );


    // ========================================================
    // START ANIMATION
    // ========================================================

    animate();

}


// ============================================================
// MOUSE DOWN
// ============================================================

function mouseDown(event) {

    isDragging = true;

    previousMouseX =
        event.clientX;

    previousMouseY =
        event.clientY;

}


// ============================================================
// MOUSE MOVE
// ============================================================

function mouseMove(event) {


    if (!isDragging) {

        return;

    }


    var deltaX =
        event.clientX -
        previousMouseX;


    var deltaY =
        event.clientY -
        previousMouseY;


    targetRotationY +=
        deltaX * 0.01;


    targetRotationX +=
        deltaY * 0.01;


    previousMouseX =
        event.clientX;


    previousMouseY =
        event.clientY;

}


// ============================================================
// MOUSE UP
// ============================================================

function mouseUp() {

    isDragging = false;

}


// ============================================================
// TOUCH START
// ============================================================

function touchStart(event) {


    if (
        event.touches.length !== 1
    ) {

        return;

    }


    isDragging = true;


    previousMouseX =
        event.touches[0].clientX;


    previousMouseY =
        event.touches[0].clientY;

}


// ============================================================
// TOUCH MOVE
// ============================================================

function touchMove(event) {


    if (
        !isDragging ||
        event.touches.length !== 1
    ) {

        return;

    }


    event.preventDefault();


    var x =
        event.touches[0].clientX;


    var y =
        event.touches[0].clientY;


    var deltaX =
        x - previousMouseX;


    var deltaY =
        y - previousMouseY;


    targetRotationY +=
        deltaX * 0.01;


    targetRotationX +=
        deltaY * 0.01;


    previousMouseX = x;

    previousMouseY = y;

}


// ============================================================
// TOUCH END
// ============================================================

function touchEnd() {

    isDragging = false;

}


// ============================================================
// MOUSE WHEEL
// ============================================================

function mouseWheel(event) {


    event.preventDefault();


    cameraDistance +=
        event.deltaY * 0.5;


    // Minimum zoom

    if (
        cameraDistance < 150
    ) {

        cameraDistance = 150;

    }


    // Maximum zoom

    if (
        cameraDistance > 900
    ) {

        cameraDistance = 900;

    }

}


// ============================================================
// ANIMATION
// ============================================================

function animate() {


    requestAnimationFrame(
        animate
    );


    // --------------------------------------------------------
    // Smooth rotation
    // --------------------------------------------------------

    rotationX +=
        (
            targetRotationX -
            rotationX
        ) * 0.08;


    rotationY +=
        (
            targetRotationY -
            rotationY
        ) * 0.08;


    if (particles) {

        particles.rotation.x =
            rotationX;


        particles.rotation.y =
            rotationY;

    }


    // --------------------------------------------------------
    // Camera zoom
    // --------------------------------------------------------

    camera.position.z +=
        (
            cameraDistance -
            camera.position.z
        ) * 0.08;


    camera.lookAt(
        scene.position
    );


    renderer.render(
        scene,
        camera
    );

}


// ============================================================
// RESIZE
// ============================================================

function resize() {


    var container =
        getElement("threeContainer");


    camera.aspect =
        container.clientWidth /
        container.clientHeight;


    camera.updateProjectionMatrix();


    renderer.setSize(
        container.clientWidth,
        container.clientHeight
    );

}


