            <!-- PARTICLE SIZE -->

            <div class="control">

                <div class="control-header">

                    <span class="control-name">
                        Particle Size
                    </span>

                    <span id="particleSizeValue"
                          class="control-value">

                        @Model.ParticleSize.ToString("0.0")

                    </span>

                </div>


                <input type="range"
                       id="particleSize"
                       min="0.5"
                       max="5"
                       step="0.1"
                       value="@Model.ParticleSize" />


                <div class="range-info">

                    <span>0.5</span>

                    <span>5</span>

