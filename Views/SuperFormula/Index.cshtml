                </div>

            </div>


            <!-- N1B -->

            <div class="control">

                <div class="control-header">

                    <span class="control-name">
                        Vertical N1
                    </span>

                    <span id="n1bValue"
                          class="control-value">

                        @Model.N1B.ToString("0.00")

                    </span>

                </div>


                <input type="range"
                       id="n1b"
