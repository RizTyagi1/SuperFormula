                <div class="range-info">

                    <span>0.05</span>

                    <span>5</span>

                </div>

            </div>


            <!-- N2B -->

            <div class="control">

                <div class="control-header">

                    <span class="control-name">
                        Vertical N2
                    </span>

                    <span id="n2bValue"
                          class="control-value">

                        @Model.N2B.ToString("0.00")

                    </span>

                </div>


                <input type="range"
                       id="n2b"
