@model WebApplication2.Models.SuperFormulaModel

@{
    ViewBag.Title = "3D Super Formula";
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        3D Super Formula
    </title>


    <!-- =====================================================
         THREE.JS
         ===================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>


    <style>

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;

            padding: 0;

            width: 100%;

            height: 100%;

            overflow: hidden;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #000;
        }


        body {
            color: white;
        }


        /* =================================================
           MAIN APPLICATION
           ================================================= */

        .app {
            width: 100%;

            height: 100vh;

            display: flex;

            background: #000;
        }


        /* =================================================
           LEFT CONTROL PANEL
           ================================================= */

        .controls {
            width: 360px;

            min-width: 360px;

            height: 100%;

            overflow-y: auto;

            background:
                linear-gradient(
                    180deg,
                    #10101a,
                    #050509
                );

            border-right:
                1px solid #252535;

            padding: 25px;
        }


        .title {
            font-size: 26px;

            font-weight: bold;

            margin-bottom: 5px;
        }


        .subtitle {
            color: #888;

            font-size: 13px;

            margin-bottom: 25px;
        }


        .section-title {
            font-size: 16px;

            font-weight: bold;

            color: #00ffff;

            margin-top: 25px;

            margin-bottom: 18px;

            padding-bottom: 8px;

            border-bottom:
                1px solid #252535;
        }


        /* =================================================
           SLIDER
           ================================================= */

        .control {
            margin-bottom: 20px;
        }


        .control-header {
            display: flex;

            justify-content:
                space-between;

            align-items: center;

            margin-bottom: 8px;
        }


        .control-name {
            font-size: 14px;

            font-weight: bold;
        }


        .control-value {
            color: #00ffff;

            background: #111;

            border:
                1px solid #303040;

            padding:
                4px 9px;

            border-radius: 5px;

            min-width: 65px;

            text-align: center;

            font-size: 13px;
        }


        input[type=range] {
            width: 100%;

            cursor: pointer;

            accent-color: #00ffff;
        }


        .range-info {
            display: flex;

            justify-content:
                space-between;

            color: #666;

            font-size: 10px;

            margin-top: 3px;
        }


        /* =================================================
           BUTTONS
           ================================================= */

        .buttons {
            display: flex;

            gap: 10px;

            margin-top: 25px;

            margin-bottom: 25px;
        }


        button {
            flex: 1;

            padding: 11px;

            border: none;

            border-radius: 6px;

            cursor: pointer;

            font-weight: bold;

            color: white;

            background: #202030;
        }


        button:hover {
            background: #303040;
        }


        #randomButton {
            background: #006b70;
        }


        #randomButton:hover {
            background: #008b90;
        }


        /* =================================================
           INFORMATION
           ================================================= */

        .info {
            font-size: 12px;

            line-height: 1.6;

            color: #777;

            padding-top: 10px;
        }


        .info strong {
            color: #aaa;
        }


        /* =================================================
           3D AREA
           ================================================= */

        .viewer {
            position: relative;

            flex: 1;

            height: 100%;

            overflow: hidden;

            background: #000;
        }


        #threeContainer {
            width: 100%;

            height: 100%;
        }


        /* =================================================
           TOP LABEL
           ================================================= */

        .viewer-title {
            position: absolute;

            top: 25px;

            left: 30px;

            z-index: 10;

            pointer-events: none;
        }


        .viewer-title h1 {
            margin: 0;

            font-size: 24px;

            letter-spacing: 2px;
        }


        .viewer-title p {
            margin-top: 6px;

            color: #777;

            font-size: 12px;
        }


        /* =================================================
           BOTTOM INFORMATION
           ================================================= */

        .viewer-help {
            position: absolute;

            bottom: 20px;

            left: 50%;

            transform:
                translateX(-50%);

            color: #666;

            font-size: 12px;

            z-index: 10;

            pointer-events: none;

            white-space: nowrap;
        }


        /* =================================================
           MOBILE
           ================================================= */

        @@media(max-width: 800px) {

            .app {
                flex-direction: column;
            }


            .controls {
                width: 100%;

                min-width: 100%;

                height: 45%;

                border-right: none;

                border-bottom:
                    1px solid #252535;
            }


            .viewer {
                height: 55%;
            }

        }

    </style>

</head>


<body>


    <div class="app">


        <!-- =====================================================
             LEFT CONTROL PANEL
             ===================================================== -->

